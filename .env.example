# 複製成 .env.local（本機）或設定在 Vercel 專案的 Environment Variables。不要提交真正的值。

# 解籤供應商（至少填一個金鑰；只放後端，App 端不會出現）
GEMINI_API_KEY=
NVIDIA_API_KEY=

# 選填：使用順序（前一家在開始輸出前失敗才換下一家）與模型
# 模型 ID 會隨供應商更新，用 `npm run models` 列出你的金鑰目前可用的模型
INTERPRET_PROVIDERS=gemini,nvidia
GEMINI_MODEL=gemini-3.6-flash
NVIDIA_MODEL=deepseek-ai/deepseek-v4.1-flash
INTERPRET_MAX_TOKENS=4096

# 正式環境建議設定：速率限制用的 Upstash Redis。
# 從 Vercel Marketplace 加 Upstash 會自動帶入 KV_REST_API_URL／KV_REST_API_TOKEN，不用另外填這兩個。
# 未設定時退回單一執行個體的記憶體計數（擋不住分散的請求）。
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# 上限（選填，預設如下）：每個 IP 每小時／每天，全站每天（台灣時間換日）
RATE_LIMIT_PER_HOUR=10
RATE_LIMIT_PER_DAY=30
RATE_LIMIT_GLOBAL_PER_DAY=500
