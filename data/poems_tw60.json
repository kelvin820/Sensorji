{
 "source": "新港奉天宮六十甲子籤，依官網籤紙圖片辨讀",
 "poems": [
  {
   "number": 1,
   "ganzhi": "甲子",
   "lines": [
    "日出便見風雲散",
    "光明清靜照世間",
    "一向前途通大道",
    "萬事清吉保平安"
   ]
  },
  {
   "number": 2,
   "ganzhi": "甲寅",
   "lines": [
    "於今此景正當時",
    "看看欲吐百花魁",
    "若能遇得春色到",
    "一洒清吉脫塵埃"
   ]
  },
  {
   "number": 3,
   "ganzhi": "甲辰",
   "lines": [
    "勸君把定心莫虛",
    "天註衣祿自有餘",
    "和合重重常吉慶",
    "時來終遇得明珠"
   ]
  },
  {
   "number": 4,
   "ganzhi": "甲午",
   "lines": [
    "風恬浪靜可行舟",
    "恰是中秋月一輪",
    "凡事不須多憂慮",
    "福祿自有慶家門"
   ]
  },
  {
   "number": 5,
   "ganzhi": "甲申",
   "lines": [
    "只恐前途命有變",
    "勸君作急可宜先",
    "且守長江無大事",
    "命逢太白守身邊"
   ]
  },
  {
   "number": 6,
   "ganzhi": "甲戌",
   "lines": [
    "風雲致雨落洋洋",
    "天災時氣必有傷",
    "命內此事難和合",
    "更逢一足出外鄉"
   ]
  },
  {
   "number": 7,
   "ganzhi": "乙丑",
   "lines": [
    "雲開月出見分明",
    "不須進退問前程",
    "婚姻皆由天註定",
    "和合清吉萬事成"
   ]
  },
  {
   "number": 8,
   "ganzhi": "乙卯",
   "lines": [
    "禾稻看看結成完",
    "此事必定兩相全",
    "回到家中寬心坐",
    "妻兒鼓舞樂團圓"
   ]
  },
  {
   "number": 9,
   "ganzhi": "乙巳",
   "lines": [
    "龍虎相隨在深山",
    "君爾何須背後看",
    "不知此去相愛悞",
    "他日與我却無干"
   ]
  },
  {
   "number": 10,
   "ganzhi": "乙未",
   "lines": [
    "花開結子一半枯",
    "可惜今年爾虛度",
    "漸漸日落西山去",
    "勸君不用向前途"
   ]
  },
  {
   "number": 11,
   "ganzhi": "乙酉",
   "lines": [
    "靈雞漸漸見分明",
    "凡事且看子丑寅",
    "雲開月出照天下",
    "郎君即便見太平"
   ]
  },
  {
   "number": 12,
   "ganzhi": "乙亥",
   "lines": [
    "長江風浪漸漸靜",
    "于今得進可安寧",
    "必有貴人相扶助",
    "凶事脫出見太平"
   ]
  },
  {
   "number": 13,
   "ganzhi": "丙子",
   "lines": [
    "命內正逢羅孛關",
    "用盡心機總未休",
    "作福問神難得過",
    "恰是行舟上高灘"
   ]
  },
  {
   "number": 14,
   "ganzhi": "丙寅",
   "lines": [
    "財中漸漸見分明",
    "花開花謝結子成",
    "寬心且看月中桂",
    "郎君即便見太平"
   ]
  },
  {
   "number": 15,
   "ganzhi": "丙辰",
   "lines": [
    "八十原來是太公",
    "看看晚景遇文王",
    "目下緊事休相問",
    "勸君且守待運通"
   ]
  },
  {
   "number": 16,
   "ganzhi": "丙午",
   "lines": [
    "不須作福不須求",
    "用盡心機總未休",
    "陽世不知陰世事",
    "官法如爐不自由"
   ]
  },
  {
   "number": 17,
   "ganzhi": "丙申",
   "lines": [
    "舊恨重重未改為",
    "家中禍患不臨身",
    "須當謹防宜作福",
    "龍蛇交會得和合"
   ]
  },
  {
   "number": 18,
   "ganzhi": "丙戌",
   "lines": [
    "君問中間此言因",
    "看看祿馬拱前程",
    "求得貴人多得利",
    "和合自有兩分明"
   ]
  },
  {
   "number": 19,
   "ganzhi": "丁丑",
   "lines": [
    "富貴由命天註定",
    "心高必然誤君期",
    "不然且回依舊路",
    "雲開月出兩分明"
   ]
  },
  {
   "number": 20,
   "ganzhi": "丁卯",
   "lines": [
    "前途功名未得意",
    "只恐命內有交加",
    "兩家必定防損失",
    "勸君且退莫咨嗟"
   ]
  },
  {
   "number": 21,
   "ganzhi": "丁巳",
   "lines": [
    "十方佛法有靈通",
    "大難禍患不相同",
    "紅日當空常照耀",
    "還有貴人到家堂"
   ]
  },
  {
   "number": 22,
   "ganzhi": "丁未",
   "lines": [
    "太公家業八十成",
    "月出光輝四海明",
    "命內自然逢大吉",
    "茅屋中間百事亨"
   ]
  },
  {
   "number": 23,
   "ganzhi": "丁酉",
   "lines": [
    "欲去長江水闊茫",
    "前途未遂運未通",
    "如今絲綸常在手",
    "只恐魚水不相逢"
   ]
  },
  {
   "number": 24,
   "ganzhi": "丁亥",
   "lines": [
    "月出光輝四海明",
    "前途祿位見太平",
    "浮雲掃退終無事",
    "可保禍患不臨身"
   ]
  },
  {
   "number": 25,
   "ganzhi": "戊子",
   "lines": [
    "總是前途莫心勞",
    "求神問聖枉是多",
    "但看雞犬日過後",
    "不須作福事如何"
   ]
  },
  {
   "number": 26,
   "ganzhi": "戊寅",
   "lines": [
    "選出牡丹第一枝",
    "勸君折取莫遲疑",
    "世間若問相知處",
    "萬事逢春正及時"
   ]
  },
  {
   "number": 27,
   "ganzhi": "戊辰",
   "lines": [
    "君爾寬心且自由",
    "門庭清吉家無憂",
    "財寶自然終吉利",
    "凡事無傷不用求"
   ]
  },
  {
   "number": 28,
   "ganzhi": "戊午",
   "lines": [
    "於今莫作此當時",
    "虎落平洋被犬欺",
    "世間凡事何難定",
    "千山萬水也遲疑"
   ]
  },
  {
   "number": 29,
   "ganzhi": "戊申",
   "lines": [
    "枯木可惜未逢春",
    "如今還在暗中藏",
    "寬心且守風霜退",
    "還君依舊作乾坤"
   ]
  },
  {
   "number": 30,
   "ganzhi": "戊戌",
   "lines": [
    "漸漸看此月中和",
    "過後須妨未得高",
    "改變顏色前途去",
    "凡事必定見重勞"
   ]
  },
  {
   "number": 31,
   "ganzhi": "己丑",
   "lines": [
    "綠柳蒼蒼正當時",
    "任君此去作乾坤",
    "花菓結實無殘謝",
    "福祿自有慶家門"
   ]
  },
  {
   "number": 32,
   "ganzhi": "己卯",
   "lines": [
    "龍虎相交在門前",
    "此事必定兩相連",
    "黃金忽然變成鐵",
    "何用作福問神仙"
   ]
  },
  {
   "number": 33,
   "ganzhi": "己巳",
   "lines": [
    "欲去長江水闊茫",
    "行舟把定未遭風",
    "戶內用心再作福",
    "看看魚水得相逢"
   ]
  },
  {
   "number": 34,
   "ganzhi": "己未",
   "lines": [
    "危險高山行過盡",
    "莫嫌此路有重重",
    "若見蘭桂漸漸發",
    "去蛇反轉變成龍"
   ]
  },
  {
   "number": 35,
   "ganzhi": "己酉",
   "lines": [
    "此事何須用心機",
    "前途變怪自然知",
    "看看此去得和合",
    "漸漸脫出見太平"
   ]
  },
  {
   "number": 36,
   "ganzhi": "己亥",
   "lines": [
    "福如東海壽如山",
    "君爾何須嘆苦難",
    "命內自然逢大吉",
    "祈保分明得自安"
   ]
  },
  {
   "number": 37,
   "ganzhi": "庚子",
   "lines": [
    "運逢得意身顯變",
    "君爾身中皆有益",
    "一向前途無難事",
    "決意之中保清吉"
   ]
  },
  {
   "number": 38,
   "ganzhi": "庚寅",
   "lines": [
    "名顯有意在中間",
    "不須祈禱心自安",
    "看看早晚日過後",
    "即時得意在中間"
   ]
  },
  {
   "number": 39,
   "ganzhi": "庚辰",
   "lines": [
    "意中若問神仙路",
    "勸爾且退望高樓",
    "寬心且守寬心坐",
    "必然遇得貴人扶"
   ]
  },
  {
   "number": 40,
   "ganzhi": "庚午",
   "lines": [
    "平生富貴成祿位",
    "君家門戶定光輝",
    "此中必定無損失",
    "夫妻百歲喜相隨"
   ]
  },
  {
   "number": 41,
   "ganzhi": "庚申",
   "lines": [
    "今行到手寔難推",
    "歌歌暢飲自徘徊",
    "雞犬相聞消息近",
    "婚姻夙世結成雙"
   ]
  },
  {
   "number": 42,
   "ganzhi": "庚戌",
   "lines": [
    "一重江水一重山",
    "誰知此去路又難",
    "任他改求終不過",
    "是非終久未得安"
   ]
  },
  {
   "number": 43,
   "ganzhi": "辛丑",
   "lines": [
    "一年作事急如飛",
    "君爾寬心莫遲疑",
    "貴人還在千里外",
    "音信月中漸漸知"
   ]
  },
  {
   "number": 44,
   "ganzhi": "辛卯",
   "lines": [
    "客到前途多得利",
    "君爾何故兩相疑",
    "雖是中間逢進退",
    "月出光輝得運時"
   ]
  },
  {
   "number": 45,
   "ganzhi": "辛巳",
   "lines": [
    "花開今已結成菓",
    "富貴榮華終到老",
    "君子小人結會合",
    "萬事清吉莫煩惱"
   ]
  },
  {
   "number": 46,
   "ganzhi": "辛未",
   "lines": [
    "功名得位與君顯",
    "前途富貴喜安然",
    "若遇一輪明月照",
    "十五團圓照滿天"
   ]
  },
  {
   "number": 47,
   "ganzhi": "辛酉",
   "lines": [
    "君爾何須問聖跡",
    "自己心中皆有益",
    "于今且看月中旬",
    "凶事脫出化成吉"
   ]
  },
  {
   "number": 48,
   "ganzhi": "辛亥",
   "lines": [
    "陰世作事未和同",
    "雲遮月色正朦朧",
    "心中意欲前途去",
    "只恐前途運未通"
   ]
  },
  {
   "number": 49,
   "ganzhi": "壬子",
   "lines": [
    "言語雖多不可從",
    "風雲靜處未行龍",
    "暗中終得明消息",
    "君爾何須問重重"
   ]
  },
  {
   "number": 50,
   "ganzhi": "壬寅",
   "lines": [
    "佛前發誓無異心",
    "且看前途得好音",
    "此物原來本是鐵",
    "亦能變化得成金"
   ]
  },
  {
   "number": 51,
   "ganzhi": "壬辰",
   "lines": [
    "東西南北不堪行",
    "前途此事正可當",
    "勸君把定莫煩惱",
    "家門自有保安康"
   ]
  },
  {
   "number": 52,
   "ganzhi": "壬午",
   "lines": [
    "功名事業本由天",
    "不須介念意懸懸",
    "若問中間遲與速",
    "風雲際會在眼前"
   ]
  },
  {
   "number": 53,
   "ganzhi": "壬申",
   "lines": [
    "看君來問心中事",
    "積善之家慶有餘",
    "運亨財子雙雙至",
    "指日喜氣溢門閭"
   ]
  },
  {
   "number": 54,
   "ganzhi": "壬戌",
   "lines": [
    "孤燈寂寂夜沉沉",
    "萬事清吉萬事成",
    "若逢陰中有善果",
    "燒得好香達神明"
   ]
  },
  {
   "number": 55,
   "ganzhi": "癸丑",
   "lines": [
    "須知進退總虛言",
    "看看發暗未必全",
    "珠玉深藏還未變",
    "心中但得枉徒然"
   ]
  },
  {
   "number": 56,
   "ganzhi": "癸卯",
   "lines": [
    "病中若得苦心勞",
    "到底完全總未遭",
    "去後不須回頭問",
    "心中事務盡消磨"
   ]
  },
  {
   "number": 57,
   "ganzhi": "癸巳",
   "lines": [
    "勸君把定心莫虛",
    "前途富貴喜安然",
    "到底中間無大事",
    "又遇神仙守安居"
   ]
  },
  {
   "number": 58,
   "ganzhi": "癸未",
   "lines": [
    "蛇身意欲變成龍",
    "只恐命內運未通",
    "久病且作寬心坐",
    "言語雖多不可從"
   ]
  },
  {
   "number": 59,
   "ganzhi": "癸酉",
   "lines": [
    "有心作福莫遲疑",
    "求名清吉正當時",
    "此事必能成會合",
    "財寶自能喜相隨"
   ]
  },
  {
   "number": 60,
   "ganzhi": "癸亥",
   "lines": [
    "月出光輝本清吉",
    "浮雲總是蔽陰色",
    "戶內用心再作福",
    "當官分理便有益"
   ]
  }
 ]
}